{
  "schema": "portfolio.design-manifest.v2",
  "title": "Yashwant Das personal site",
  "updated": "2026-09-23",
  "kind": "static-web, prerendered at build time",
  "entryFile": "index.html",
  "sourceFiles": {
    "html": ["index.html"],
    "css": ["css/style.css"],
    "typescript": {
      "buildTime": ["src/render.ts", "src/icons.ts", "vite.config.ts"],
      "browser": ["src/main.ts", "src/theme.ts", "src/utils.ts"],
      "shared": ["src/types.ts"]
    },
    "data": ["data/content.json", "data/schema.json"],
    "logos": "src/icons/*.svg (single-colour, currentColor), plus Simple Icons slugs",
    "public": ["public/assets/avatars/avatar.webp", "public/favicon.svg"]
  },
  "designReferences": { "handoff": "DESIGN-HANDOFF.md" },
  "sections": [
    {
      "id": "top",
      "role": "hero",
      "data": ["name", "role", "location", "avatar", "statement", "status"]
    },
    { "id": "brands", "role": "logo wall", "data": ["brands"] },
    { "id": "toolbox", "role": "periodic table", "data": ["toolbox"] },
    { "id": "surfaces", "role": "platform list", "data": ["surfaces"] },
    { "id": "work", "role": "project index", "data": ["projects"] },
    { "id": "contact", "role": "contact", "data": ["contact"] }
  ],
  "tokens": {
    "colors": {
      "bg": { "dark": "#0b0b0b", "light": "#fbfbfa" },
      "bgHover": { "dark": "#141414", "light": "#f1f1ef" },
      "text": { "dark": "#ededed", "light": "#111111" },
      "text2": { "dark": "#a3a3a3", "light": "#555555" },
      "text3": { "dark": "#8a8a8a", "light": "#6e6e6e" },
      "line": { "dark": "#232323", "light": "#e3e3e0" },
      "lineStrong": { "dark": "#3a3a3a", "light": "#c9c9c5" },
      "logo": { "dark": "#8f8f8f", "light": "#6a6a6a" },
      "accent": { "dark": "#8aa4ff", "light": "#2448d8" },
      "status": { "dark": "#4cc38a", "light": "#1a8a5a" }
    },
    "type": {
      "display": "Instrument Serif 400",
      "ui": "system sans, 15px/1.6",
      "label": "system mono, 12px",
      "weights": [400, 500]
    },
    "layout": {
      "pageWidth": "1040px",
      "gutter": "clamp(16px, 4vw, 40px)",
      "sectionSpace": "clamp(72px, 10vw, 128px)",
      "hairline": "1px"
    }
  },
  "breakpoints": {
    "navHidden": "< 520px viewport",
    "brandColumns": { "default": 2, "480px": 4, "700px": 7 },
    "toolboxLayout": {
      "default": "group blocks, 3 cols",
      "480px": "group blocks, 4 cols",
      "700px": "one column per group"
    }
  },
  "viewportMatrix": [360, 390, 430, 600, 820, 1024, 1366, 1440, 1920],
  "rules": [
    "Neutral greys only; the accent is reserved for focus and the current-focus marker.",
    "Hairline grids, never cards or shadows.",
    "Every personal fact comes from data/content.json.",
    "Logos are monochrome currentColor and sized by equal area.",
    "Grid cells are whole pixels; hairlines are exactly 1px."
  ]
}
