{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Developer Portfolio",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -w",
    "serve": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:schema": "node scripts/validate-schema.mjs",
    "audit": "npm_config_allow_scripts=\"\" npm audit --audit-level=high",
    "validate": "npm run build && npm run check && npm run validate:schema && npm run lint && npm run format:check && npm run audit && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "25.8.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  }
}
