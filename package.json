{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Personal site of Yashwant Das",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/validate-content.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "validate": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.60.0",
    "@types/node": "25.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "prettier": "3.8.3",
    "simple-icons": "^16.32.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
