{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "visibility": {
      "type": "object",
      "properties": {
        "home": {
          "type": "boolean"
        },
        "about": {
          "type": "boolean"
        },
        "experience": {
          "type": "boolean"
        },
        "projects": {
          "type": "boolean"
        },
        "skills": {
          "type": "boolean"
        },
        "education": {
          "type": "boolean"
        },
        "certifications": {
          "type": "boolean"
        },
        "contact": {
          "type": "boolean"
        }
      }
    },
    "name": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "resume": {
      "type": "string"
    },
    "heroSummary": {
      "type": "string"
    },
    "heroStats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["value", "label"]
      }
    },
    "about": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["role", "break"],
            "description": "\"break\" marks a career break: a timeline marker, not a job. Defaults to \"role\"."
          },
          "logo": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["role", "company", "period"]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "live": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "featured": {
            "type": "boolean"
          }
        },
        "required": ["title", "description", "tags"]
      }
    },
    "skills": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "disabled": {
                    "type": "boolean"
                  }
                },
                "required": ["name"]
              }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "disabled": {
                      "type": "boolean"
                    }
                  },
                  "required": ["name"]
                }
              ]
            }
          }
        }
      ]
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": {
            "type": "string"
          },
          "school": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["degree", "school", "period"]
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "credentialUrl": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["name", "organization"]
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "socials": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "required": ["name"]
}
