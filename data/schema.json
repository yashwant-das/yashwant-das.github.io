{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio content",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "role", "statement", "contact"],
  "definitions": {
    "icon": {
      "type": "string",
      "description": "A Simple Icons slug, the basename of an SVG in src/icons/, or a built-in 'ui:' icon (ui:globe, ui:phone, ui:tv, ui:gamepad, ui:mail).",
      "pattern": "^(ui:)?[a-z0-9-]+$"
    },
    "scale": {
      "type": "number",
      "description": "Optical size correction for a logo. 1 is the default size.",
      "minimum": 0.5,
      "maximum": 4
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "visibility": {
      "type": "object",
      "description": "Set a section to false to hide it and its nav link.",
      "additionalProperties": false,
      "properties": {
        "brands": {
          "type": "boolean"
        },
        "toolbox": {
          "type": "boolean"
        },
        "surfaces": {
          "type": "boolean"
        },
        "work": {
          "type": "boolean"
        },
        "writing": {
          "type": "boolean"
        },
        "contact": {
          "type": "boolean"
        }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string"
    },
    "avatar": {
      "type": "string",
      "description": "Path relative to public/."
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "The single sentence set large in the hero."
    },
    "status": {
      "type": "string",
      "description": "Short line shown beside a status dot."
    },
    "description": {
      "type": "string",
      "description": "Meta description for search and sharing."
    },
    "brands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["client", "employer"]
              },
              "logo": {
                "$ref": "#/definitions/icon"
              },
              "scale": {
                "$ref": "#/definitions/scale"
              },
              "disabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "toolbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "items"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "group", "icon"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string"
              },
              "icon": {
                "$ref": "#/definitions/icon"
              },
              "scale": {
                "$ref": "#/definitions/scale"
              },
              "focus": {
                "type": "boolean",
                "description": "Marks a current-focus tool."
              },
              "disabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "$ref": "#/definitions/icon"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "code"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The GitHub repository name."
          },
          "description": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "format": "uri"
          },
          "stack": {
            "type": "array",
            "description": "Tools the project is built with. Each must be a toolbox item name.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "disabled": {
            "type": "boolean"
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "disabled": {
            "type": "boolean"
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "socials": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
